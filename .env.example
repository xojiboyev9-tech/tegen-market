# ---- umumiy ----
NODE_ENV=development
BOT_TOKEN=123456:ABC-from-BotFather
BOT_SECRET=change-me-long-random-string
JWT_SECRET=change-me-another-long-random-string
# Birinchi Super Admin Telegram ID lari (vergul bilan)
SUPER_ADMIN_TELEGRAM_IDS=
# ---- server ----
DATABASE_URL=postgresql://tegen:tegen@localhost:5432/tegen
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_BASE_URL=http://localhost:3000
# Rasmlar: bo'sh bo'lsa serverning ./uploads papkasiga, GCS_BUCKET bo'lsa Google Cloud Storage ga
UPLOAD_DIR=./uploads
GCS_BUCKET=
# ---- bot ----
SERVER_URL=http://localhost:3000
MINI_APP_URL=https://your-mini-app.example.com
ADMIN_APP_URL=https://your-admin.example.com
ALLOW_FILES=false
# ---- frontend (Vite) ----
VITE_API_URL=http://localhost:3000/api
# ---- production eslatmasi ----
# NODE_ENV=production bo'lsa BOT_SECRET va JWT_SECRET kamida 32 belgi bo'lishi shart:  openssl rand -hex 32
